# Start from your WRF runtime container
FROM nasanccs/fire-hnl-wrf-baselibs:latest-arm64

# Install Python 3.11 and pip
RUN dnf -y update && \
    dnf -y install python3.11 python3.11-pip && \
    ln -sf /usr/bin/python3.11 /usr/bin/python && \
    ln -sf /usr/bin/pip3.11 /usr/bin/pip

# Install build dependencies for wrf-python
RUN dnf -y install \
    python3.11-devel \
    gcc \
    gcc-c++ \
    hdf5-devel \
    libffi-devel \
    openblas-devel \
    git

# 🔧 Geospatial stack needed to build rasterio/fiona/pyproj against system GDAL
RUN dnf -y install \
    gdal gdal-devel \
    proj proj-devel \
    geos geos-devel \
    libtiff-devel libjpeg-turbo-devel openjpeg2-devel \
    sqlite-devel

# Ensure pip sees gdal-config
ENV GDAL_CONFIG=/usr/bin/gdal-config
# (Optional) some builds check this
ENV PROJ_DIR=/usr
ENV CPLUS_INCLUDE_PATH=/usr/include
ENV C_INCLUDE_PATH=/usr/include

# Export netCDF variables
ENV NETCDF=/wrf/libs/netcdf
ENV LD_LIBRARY_PATH=/usr/local/lib:/usr/local/lib/openmpi:/wrf/libs/netcdf/lib:$LD_LIBRARY_PATH
ENV CFLAGS="-I${NETCDF}/include"
ENV LDFLAGS="-L${NETCDF}/lib"

# Upgrade pip
RUN python -m pip install --upgrade pip

# Install Python packages (wrf-python last, so you see errors clearly)
#RUN pip install \
#    "numpy<2.0" \
#    omegaconf \
#    jinja2 \
#    requests \
#    pandas \
#    netCDF4 \
#    xarray \
#    rasterio \
#   metpy \
#   geopandas \
#   rioxarray \
#   xwrf
#   #git+https://github.com/NCAR/wrf-python.git@main

# Install the heavy geospatial wheels first (force binaries, no compiles)
RUN pip install --no-cache-dir --only-binary=:all: \
      shapely \
      pyproj \
      fiona \
      rasterio && \
    pip install --no-cache-dir --prefer-binary \
      "numpy<2.0" \
      pandas \
      netCDF4 \
      xarray \
      metpy \
      geopandas \
      rioxarray \
      omegaconf \
      jinja2 \
      requests \
      xwrf
