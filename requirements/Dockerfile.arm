# Start from your WRF runtime container
FROM nasanccs/fire-hnl-wrf-baselibs:latest-arm64

# Python & toolchain
RUN dnf -y update && \
    dnf -y install python3.11 python3.11-pip python3.11-devel dnf-plugins-core && \
    ln -sf /usr/bin/python3.11 /usr/bin/python && \
    ln -sf /usr/bin/pip3.11 /usr/bin/pip

# Build deps (add glibc/kheaders/pkgconf!)
RUN dnf -y install \
    gcc gcc-c++ make \
    glibc-devel glibc-headers kernel-headers pkgconf pkgconf-pkg-config \
    hdf5-devel libffi-devel openblas-devel git \
    libtiff-devel libjpeg-turbo-devel openjpeg2-devel sqlite-devel zlib-devel

# Use EL9 base/EPEL GDAL/PROJ (these are 3.4.3 / 8.2)
RUN dnf -y install gdal gdal-devel proj proj-devel geos geos-devel && \
    dnf clean all && rm -rf /var/cache/dnf

# Make sure builds can see headers/libs
ENV C_INCLUDE_PATH=/usr/include
ENV CPLUS_INCLUDE_PATH=/usr/include
ENV PKG_CONFIG_PATH=/usr/lib64/pkgconfig:/usr/local/lib64/pkgconfig

# (your netcdf env as before)
ENV NETCDF=/wrf/libs/netcdf
ENV LD_LIBRARY_PATH=/usr/local/lib:/usr/local/lib/openmpi:/wrf/libs/netcdf/lib:/usr/lib64
ENV CFLAGS="-I${NETCDF}/include"
ENV LDFLAGS="-L${NETCDF}/lib"

RUN python -m pip install --upgrade pip setuptools wheel cython

# --- Install in a compatible order/versions ---
# shapely can be a wheel; build the rest against system GDAL/PROJ (3.4.3 / 8.2)
# --only-binary=:all:
# RUN pip install --no-cache-dir --prefer-binary shapely==2.1.2 && \
#    pip install --no-cache-dir --no-binary=pyproj pyproj==3.5.0 && \
#    pip install --no-cache-dir --no-binary=rasterio rasterio==1.3.10 && \
#    pip install --no-cache-dir --prefer-binary \
#        "numpy<2.0" pandas netCDF4 xarray metpy geopandas rioxarray \
#        omegaconf jinja2 requests xwrf
# Install geo stack as **binary wheels** (bundled GDAL/PROJ), then the rest
# Order matters: shapely → pyproj → fiona → rasterio → (geopandas/rioxarray/...)
# RUN pip install \
#      --only-binary=:all: shapely==2.1.2 pyproj==3.7.2 fiona==1.9.6 rasterio==1.3.11 && \
#    pip install \
#      --prefer-binary pandas netCDF4 xarray metpy geopandas rioxarray \
#      omegaconf jinja2 requests xwrf
RUN pip install "rasterio<1.3.10" "numpy<2.0"
RUN pip install "numpy<2.0" pandas netCDF4 xarray metpy geopandas rioxarray omegaconf jinja2 requests

